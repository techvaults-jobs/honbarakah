# Form delivery through Resend (https://resend.com). Without these, submissions are only logged on the server.
RESEND_API_KEY=
# Comma-separated inboxes that receive volunteer sign-ups, messages and newsletter subscriptions
CONTACT_TO_EMAIL=
# Must be on a domain verified in Resend
CONTACT_FROM_EMAIL="B.O.B 2027 Website <noreply@barakatodunuga.com>"
# Optional: send a form to its own inbox instead of CONTACT_TO_EMAIL.
# One per form type: VOLUNTEER, ISSUE, IDEA, FEEDBACK, AGENT, REPORT, SUPPORT, NEWSLETTER, CONTACT
AGENT_TO_EMAIL=
REPORT_TO_EMAIL=
ISSUE_TO_EMAIL=
SUPPORT_TO_EMAIL=
